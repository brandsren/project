
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HyperLingua Practice - Interactive Language Learning</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .backface-hidden {
            backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 antialiased flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-600 text-white p-2 rounded-xl flex items-center justify-center font-bold text-xl shadow-md">
                    <i class="fa-solid fa-earth-americas"></i>
                </div>
                <span class="text-xl font-bold bg-gradient-to-r from-brand-600 to-indigo-800 bg-clip-text text-transparent">HyperLingua</span>
                <span class="bg-brand-50 text-brand-700 text-xs px-2 py-0.5 rounded-full font-semibold border border-brand-100">PT ⇄ EN</span>
            </div>

            <div class="flex items-center space-x-4">
                <!-- Language Pair Indicator -->
                <div class="bg-slate-100 px-3 py-1.5 rounded-lg text-slate-700 text-sm font-semibold flex items-center space-x-2">
                    <span>🇧🇷 Portuguese</span>
                    <i class="fa-solid fa-arrow-right-arrow-left text-xs text-slate-400"></i>
                    <span>🇺🇸 English</span>
                </div>

                <!-- Streak Counter -->
                <div class="flex items-center bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg text-amber-700 text-sm font-semibold shadow-sm">
                    <i class="fa-solid fa-fire mr-1.5 text-amber-500 animate-pulse"></i>
                    <span id="streakCount">5</span> Days
                </div>

                <!-- User Profile Avatar -->
                <div class="w-10 h-10 rounded-full bg-brand-100 border-2 border-brand-500 flex items-center justify-center text-brand-700 font-bold shadow-inner cursor-pointer hover:opacity-90 transition">
                    <i class="fa-solid fa-user"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Workspace -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- Sidebar Navigation -->
        <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col justify-between p-4">
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-semibold text-brand-700 bg-brand-50 transition">
                    <i class="fa-solid fa-chart-pie w-5"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="switchTab('flashcards')" id="nav-flashcards" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                    <i class="fa-solid fa-clone w-5"></i>
                    <span>Flashcards</span>
                </button>
                <button onclick="switchTab('custom-phrases')" id="nav-custom-phrases" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                    <i class="fa-solid fa-book-bookmark w-5"></i>
                    <span>My Custom Phrases</span>
                </button>
                <button onclick="switchTab('immersion')" id="nav-immersion" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                    <i class="fa-solid fa-headphones w-5"></i>
                    <span>Audio & Reading</span>
                </button>
                <button onclick="switchTab('ai-chat')" id="nav-ai-chat" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">
                    <i class="fa-solid fa-comments w-5"></i>
                    <span>AI Tutor Chat</span>
                </button>
            </nav>

            <div class="bg-slate-100 p-4 rounded-xl border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Daily Goal</span>
                    <span id="goalPercent" class="text-xs font-bold text-brand-600">80%</span>
                </div>
                <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                    <div id="goalProgressBar" class="bg-brand-600 h-full rounded-full transition-all duration-500" style="width: 80%"></div>
                </div>
                <p id="goalText" class="text-xs text-slate-500 mt-2">16 / 20 items practiced today</p>
            </div>
        </aside>

        <!-- Content Area -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-8">
            
            <!-- 1. DASHBOARD VIEW -->
            <section id="view-dashboard" class="space-y-6 max-w-5xl mx-auto">
                <div class="bg-gradient-to-r from-brand-600 to-indigo-700 text-white rounded-3xl p-6 sm:p-8 shadow-xl flex flex-col md:flex-row justify-between items-center relative overflow-hidden">
                    <div class="absolute right-0 bottom-0 opacity-10 translate-x-10 translate-y-10">
                        <i class="fa-solid fa-graduation-cap text-9xl"></i>
                    </div>
                    <div class="z-10 mb-6 md:mb-0 space-y-2">
                        <h1 class="text-2xl sm:text-3xl font-bold">Welcome back, Student! 👋</h1>
                        <p class="text-brand-100 text-sm sm:text-base max-w-lg">Master English and Portuguese by adding your own custom phrases and practicing daily.</p>
                        <div class="pt-2 flex space-x-3">
                            <button onclick="switchTab('custom-phrases')" class="bg-white text-brand-700 font-semibold px-5 py-2.5 rounded-xl shadow hover:bg-brand-50 transition text-sm">
                                <i class="fa-solid fa-plus mr-1"></i> Add Custom Phrases
                            </button>
                        </div>
                    </div>
                    <div class="z-10 bg-white/10 backdrop-blur-md p-6 rounded-2xl border border-white/20 flex space-x-6 text-center">
                        <div>
                            <div class="text-3xl font-extrabold" id="statWords">12</div>
                            <div class="text-xs text-brand-100 font-medium">Total Phrases</div>
                        </div>
                        <div class="w-px bg-white/20"></div>
                        <div>
                            <div class="text-3xl font-extrabold" id="statAccuracy">92%</div>
                            <div class="text-xs text-brand-100 font-medium">Accuracy</div>
                        </div>
                    </div>
                </div>

                <!-- Quick Practice Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div onclick="switchTab('flashcards')" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-indigo-600 group-hover:text-white transition">
                            <i class="fa-solid fa-clone"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">Flashcards</h3>
                        <p class="text-sm text-slate-500">Practice your active vocabulary deck.</p>
                    </div>

                    <div onclick="switchTab('custom-phrases')" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                        <div class="w-12 h-12 bg-brand-50 text-brand-600 rounded-xl flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-brand-600 group-hover:text-white transition">
                            <i class="fa-solid fa-book-bookmark"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">My Phrases</h3>
                        <p class="text-sm text-slate-500">Add & manage your custom sentences.</p>
                    </div>

                    <div onclick="switchTab('immersion')" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-emerald-600 group-hover:text-white transition">
                            <i class="fa-solid fa-headphones"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">Audio Stories</h3>
                        <p class="text-sm text-slate-500">Bilingual readings with speech.</p>
                    </div>

                    <div onclick="switchTab('ai-chat')" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition cursor-pointer group">
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-amber-600 group-hover:text-white transition">
                            <i class="fa-solid fa-comments"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-1">AI Tutor Chat</h3>
                        <p class="text-sm text-slate-500">Instant corrections & conversation.</p>
                    </div>
                </div>
            </section>

            <!-- 2. FLASHCARDS VIEW -->
            <section id="view-flashcards" class="hidden max-w-xl mx-auto space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-900">Vocabulary & Phrase Flashcards</h2>
                    <span id="cardProgress" class="text-sm font-semibold text-slate-500">1 / 5</span>
                </div>

                <!-- Card container -->
                <div class="perspective-1000 h-80 w-full cursor-pointer" onclick="flipCard()">
                    <div id="flashcardInner" class="relative w-full h-full duration-500 transform-style-3d shadow-xl rounded-3xl">
                        <!-- Front -->
                        <div class="absolute inset-0 bg-white border border-slate-200 rounded-3xl p-8 flex flex-col justify-between backface-hidden">
                            <div class="flex justify-between items-center text-slate-400 text-sm font-medium">
                                <span id="cardFrontLang">Portuguese (PT)</span>
                                <i class="fa-solid fa-rotate"></i>
                            </div>
                            <div class="text-center space-y-2">
                                <h3 id="cardFrontText" class="text-2xl sm:text-3xl font-extrabold text-slate-900">O prédio mais alto da cidade.</h3>
                                <p class="text-xs text-slate-400">Click to flip card</p>
                            </div>
                            <div class="flex justify-center space-x-2">
                                <button onclick="event.stopPropagation(); playPronunciation(document.getElementById('cardFrontText').innerText, 'pt-BR');" class="bg-brand-50 text-brand-600 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-brand-100 transition">
                                    <i class="fa-solid fa-volume-high mr-2"></i> Listen (PT)
                                </button>
                            </div>
                        </div>
                        <!-- Back -->
                        <div class="absolute inset-0 bg-brand-600 text-white rounded-3xl p-8 flex flex-col justify-between backface-hidden rotate-y-180">
                            <div class="flex justify-between items-center text-brand-200 text-sm font-medium">
                                <span id="cardBackLang">English Translation (EN)</span>
                                <i class="fa-solid fa-rotate"></i>
                            </div>
                            <div class="text-center space-y-3">
                                <h3 id="cardBackText" class="text-2xl sm:text-3xl font-extrabold">The tallest building in the city.</h3>
                            </div>
                            <div class="flex justify-center">
                                <button onclick="event.stopPropagation(); playPronunciation(document.getElementById('cardBackText').innerText, 'en-US');" class="bg-white/20 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-white/30 transition">
                                    <i class="fa-solid fa-volume-high mr-2"></i> Listen (EN)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="grid grid-cols-3 gap-4 pt-4">
                    <button onclick="nextCard('hard')" class="bg-rose-50 text-rose-700 border border-rose-200 py-3 rounded-xl font-bold text-sm hover:bg-rose-100 transition">
                        Hard
                    </button>
                    <button onclick="nextCard('good')" class="bg-amber-50 text-amber-700 border border-amber-200 py-3 rounded-xl font-bold text-sm hover:bg-amber-100 transition">
                        Good
                    </button>
                    <button onclick="nextCard('easy')" class="bg-emerald-50 text-emerald-700 border border-emerald-200 py-3 rounded-xl font-bold text-sm hover:bg-emerald-100 transition">
                        Easy
                    </button>
                </div>
            </section>

            <!-- 3. CUSTOM PHRASES VIEW -->
            <section id="view-custom-phrases" class="hidden max-w-3xl mx-auto space-y-6">
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900">My Custom Phrases & Sentences</h2>
                            <p class="text-sm text-slate-500">Add your own Portuguese and English sentences for custom study and flashcards.</p>
                        </div>
                        <span id="customPhraseCount" class="bg-brand-50 text-brand-700 font-bold text-xs px-3 py-1 rounded-full border border-brand-100">0 Items</span>
                    </div>

                    <!-- Global Toggle Visibility Controls for Quiz Mode -->
                    <div class="bg-brand-50 border border-brand-100 p-4 rounded-2xl flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-2 text-sm font-semibold text-brand-900">
                            <i class="fa-solid fa-eye-slash text-brand-600"></i>
                            <span>Global Quiz Mode (Hide All):</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <label class="inline-flex items-center text-xs font-semibold text-slate-700 cursor-pointer bg-white px-3 py-1.5 rounded-xl border border-brand-200 shadow-sm">
                                <input type="checkbox" id="hidePtGlobal" onchange="toggleGlobalHide()" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500 mr-2">
                                Hide All Portuguese (PT)
                            </label>
                            <label class="inline-flex items-center text-xs font-semibold text-slate-700 cursor-pointer bg-white px-3 py-1.5 rounded-xl border border-brand-200 shadow-sm">
                                <input type="checkbox" id="hideEnGlobal" onchange="toggleGlobalHide()" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500 mr-2">
                                Hide All English (EN)
                            </label>
                        </div>
                    </div>

                    <!-- Add Form -->
                    <form onsubmit="addCustomPhrase(event)" class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-4">
                        <h3 class="text-sm font-bold text-slate-800 flex items-center">
                            <i class="fa-solid fa-plus-circle text-brand-600 mr-2"></i> Add New Phrase Pair
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Portuguese (PT)</label>
                                <textarea id="newPtPhrase" rows="2" required placeholder="Ex: Eu gostaria de tomar um café, por favor." class="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">English (EN)</label>
                                <textarea id="newEnPhrase" rows="2" required placeholder="Ex: I would like to have a coffee, please." class="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
                            </div>
                        </div>
                        <div class="flex justify-end">
                            <button type="submit" class="bg-brand-600 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow hover:bg-brand-700 transition">
                                <i class="fa-solid fa-check mr-1.5"></i> Save Phrase
                            </button>
                        </div>
                    </form>

                    <!-- Phrases List -->
                    <div class="space-y-3" id="customPhrasesListContainer">
                        <!-- Populated dynamically -->
                    </div>
                </div>
            </section>

            <!-- 4. IMMERSION / AUDIO & READING VIEW -->
            <section id="view-immersion" class="hidden max-w-3xl mx-auto space-y-6">
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900">O Café da Manhã em Lisboa</h2>
                            <p class="text-sm text-slate-500">Portuguese ⇄ English Bilingual Reading</p>
                        </div>
                        <button onclick="toggleAudioPlayback()" id="playAudioBtn" class="bg-brand-600 text-white w-12 h-12 rounded-full flex items-center justify-center text-lg shadow-lg hover:bg-brand-700 transition">
                            <i class="fa-solid fa-play" id="playIcon"></i>
                        </button>
                    </div>

                    <!-- Audio Progress Bar -->
                    <div class="space-y-1">
                        <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden cursor-pointer" id="audioTimeline">
                            <div id="audioProgress" class="bg-brand-600 h-full w-0 transition-all"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-400 font-medium">
                            <span id="audioCurrentTime">0:00</span>
                            <span id="audioTotalTime">0:45</span>
                        </div>
                    </div>

                    <!-- Interactive Text Passage -->
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 text-lg leading-relaxed text-slate-700 space-y-4">
                        <p class="cursor-pointer hover:bg-brand-50 p-2 rounded-lg transition" onclick="translateSentence(this, 'O sol nasceu brilhante sobre as ruas históricas de Lisboa na manhã de terça-feira.', 'The sun rose brightly over the historic streets of Lisbon on Tuesday morning.')">
                            O sol nasceu brilhante sobre as ruas históricas de Lisboa na manhã de terça-feira. <span class="text-xs text-brand-600 font-semibold block mt-1">(Click for English translation & audio)</span>
                        </p>
                        <p class="cursor-pointer hover:bg-brand-50 p-2 rounded-lg transition" onclick="translateSentence(this, 'Ana entrou na pastelaria tradicional e pediu um pastel de nata quentinho com um café expresso.', 'Ana walked into the traditional bakery and ordered a warm custard tart with an espresso coffee.')">
                            Ana entrou na pastelaria tradicional e pediu um pastel de nata quentinho com um café expresso. <span class="text-xs text-brand-600 font-semibold block mt-1">(Click for English translation & audio)</span>
                        </p>
                        <p class="cursor-pointer hover:bg-brand-50 p-2 rounded-lg transition" onclick="translateSentence(this, 'Ela planeava explorar o Castelo de São Jorge à tarde.', 'She planned to explore St. George Castle in the afternoon.')">
                            Ela planeava explorar o Castelo de São Jorge à tarde. <span class="text-xs text-brand-600 font-semibold block mt-1">(Click for English translation & audio)</span>
                        </p>
                    </div>

                    <div id="translationBox" class="hidden bg-brand-50 border border-brand-100 p-4 rounded-xl text-sm text-brand-900 font-medium space-y-2">
                        <div><span class="font-bold">Portuguese:</span> <span id="transPt"></span></div>
                        <div><span class="font-bold">English:</span> <span id="transEn"></span></div>
                        <div class="pt-1 flex space-x-2">
                            <button onclick="playPronunciation(document.getElementById('transPt').innerText, 'pt-BR')" class="bg-white text-brand-700 px-3 py-1 rounded-lg text-xs font-bold border border-brand-200">
                                <i class="fa-solid fa-volume-high mr-1"></i> Listen PT
                            </button>
                            <button onclick="playPronunciation(document.getElementById('transEn').innerText, 'en-US')" class="bg-white text-brand-700 px-3 py-1 rounded-lg text-xs font-bold border border-brand-200">
                                <i class="fa-solid fa-volume-high mr-1"></i> Listen EN
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. AI TUTOR CHAT VIEW -->
            <section id="view-ai-chat" class="hidden max-w-3xl mx-auto h-[calc(100vh-10rem)] flex flex-col bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900">HyperLingua AI Tutor (EN ⇄ PT)</h3>
                            <p class="text-xs text-emerald-600 font-semibold flex items-center">
                                <span class="w-2 h-2 bg-emerald-500 rounded-full inline-block mr-1.5 animate-pulse"></span> Online & Ready
                            </p>
                        </div>
                    </div>
                    <button onclick="clearChat()" class="text-slate-400 hover:text-slate-600 text-sm font-medium">Clear Chat</button>
                </div>

                <!-- Chat Messages Stream -->
                <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4">
                    <div class="flex items-start space-x-3">
                        <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                        <div class="bg-slate-100 text-slate-800 px-4 py-3 rounded-2xl rounded-tl-none max-w-md text-sm leading-relaxed">
                            Hello! I am your AI language tutor for English and Portuguese. Ask me for translations, grammar explanations, or let's practice conversation!
                        </div>
                    </div>
                </div>

                <!-- Chat Input Form -->
                <div class="p-4 border-t border-slate-200 bg-white">
                    <form onsubmit="sendChatMessage(event)" class="flex space-x-2">
                        <input type="text" id="chatInput" placeholder="Type a message or ask for translation (e.g. Translate to English: ...)" class="flex-1 bg-slate-100 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <button type="submit" class="bg-brand-600 text-white px-5 py-3 rounded-xl font-semibold hover:bg-brand-700 transition shadow">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </section>

        </main>
    </div>

    <script>
        // Default Custom Phrases Data
        let customPhrases = JSON.parse(localStorage.getItem('hyperlingua_phrases')) || [
            { pt: "O prédio mais alto da cidade.", en: "The tallest building in the city." },
            { pt: "Eu gostaria de comprar uma passagem de ida e volta.", en: "I would like to buy a round-trip ticket." },
            { pt: "Por favor, onde fica a estação de trem mais próxima?", en: "Please, where is the nearest train station?" }
        ];

        let hidePt = false;
        let hideEn = false;

        function toggleGlobalHide() {
            hidePt = document.getElementById('hidePtGlobal').checked;
            hideEn = document.getElementById('hideEnGlobal').checked;
            renderCustomPhrasesList();
        }

        function saveCustomPhrases() {
            localStorage.setItem('hyperlingua_phrases', JSON.stringify(customPhrases));
            updateDashboardStats();
            renderCustomPhrasesList();
        }

        // Tab switching logic
        function switchTab(tabId) {
            ['dashboard', 'flashcards', 'custom-phrases', 'immersion', 'ai-chat'].forEach(id => {
                const view = document.getElementById(`view-${id}`);
                if (view) view.classList.add('hidden');
                const navBtn = document.getElementById(`nav-${id}`);
                if (navBtn) {
                    navBtn.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition";
                }
            });

            const targetView = document.getElementById(`view-${tabId}`);
            if (targetView) targetView.classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-semibold text-brand-700 bg-brand-50 transition";
            }

            if (tabId === 'flashcards') {
                initFlashcards();
            }
            if (tabId === 'custom-phrases') {
                renderCustomPhrasesList();
            }
        }

        // Flashcard State
        let currentCardIndex = 0;
        let isCardFlipped = false;

        function initFlashcards() {
            currentCardIndex = 0;
            isCardFlipped = false;
            showCurrentCard();
        }

        function showCurrentCard() {
            const list = customPhrases.length > 0 ? customPhrases : [{ pt: "Nenhuma frase cadastrada.", en: "No phrases added yet." }];
            if (currentCardIndex >= list.length) currentCardIndex = 0;
            const item = list[currentCardIndex];

            document.getElementById('cardFrontText').innerText = item.pt;
            document.getElementById('cardBackText').innerText = item.en;
            document.getElementById('cardProgress').innerText = `${currentCardIndex + 1} / ${list.length}`;
            
            const inner = document.getElementById('flashcardInner');
            if (inner) {
                inner.style.transform = 'rotateY(0deg)';
                isCardFlipped = false;
            }
        }

        function flipCard() {
            const inner = document.getElementById('flashcardInner');
            isCardFlipped = !isCardFlipped;
            if (isCardFlipped) {
                inner.style.transform = 'rotateY(180deg)';
            } else {
                inner.style.transform = 'rotateY(0deg)';
            }
        }

        function nextCard(rating) {
            const list = customPhrases.length > 0 ? customPhrases : [1];
            currentCardIndex = (currentCardIndex + 1) % list.length;
            showCurrentCard();
        }

        function playPronunciation(text, lang) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = lang;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Custom Phrases Management
        function addCustomPhrase(e) {
            e.preventDefault();
            const pt = document.getElementById('newPtPhrase').value.trim();
            const en = document.getElementById('newEnPhrase').value.trim();
            if (!pt || !en) return;

            customPhrases.unshift({ pt, en });
            saveCustomPhrases();

            document.getElementById('newPtPhrase').value = '';
            document.getElementById('newEnPhrase').value = '';
            
            // Notification or feedback
            alertBox("Phrase successfully added to your study deck!");
        }

        function deleteCustomPhrase(index) {
            customPhrases.splice(index, 1);
            saveCustomPhrases();
        }

        function renderCustomPhrasesList() {
            const container = document.getElementById('customPhrasesListContainer');
            document.getElementById('customPhraseCount').innerText = `${customPhrases.length} Items`;
            
            if (customPhrases.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400 text-sm">
                        No custom phrases added yet. Add your first pair above!
                    </div>
                `;
                return;
            }

            container.innerHTML = customPhrases.map((item, idx) => {
                // Determine visibility for this specific card using local overrides or global hide
                const isPtHidden = item.hidePt !== undefined ? item.hidePt : hidePt;
                const isEnHidden = item.hideEn !== undefined ? item.hideEn : hideEn;

                const ptDisplay = isPtHidden 
                    ? `<span class="bg-slate-200 text-slate-400 px-2.5 py-1 rounded-lg text-sm select-none blur-sm hover:blur-none transition cursor-pointer" title="Click to reveal">${escapeHtml(item.pt)}</span>`
                    : escapeHtml(item.pt);

                const enDisplay = isEnHidden
                    ? `<span class="bg-slate-200 text-slate-400 px-2.5 py-1 rounded-lg text-sm select-none blur-sm hover:blur-none transition cursor-pointer" title="Click to reveal">${escapeHtml(item.en)}</span>`
                    : escapeHtml(item.en);

                return `
                <div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div class="space-y-2 flex-1">
                        <div class="text-sm font-bold text-slate-900 flex items-center flex-wrap gap-2">
                            <span class="w-6 h-6 rounded-full bg-brand-100 text-brand-700 text-xs flex items-center justify-center font-bold">${idx + 1}</span>
                            <span class="text-xs bg-slate-200 text-slate-700 px-1.5 py-0.5 rounded">PT</span>
                            <span class="flex-1">${ptDisplay}</span>
                        </div>
                        <div class="text-sm text-slate-600 pl-8 flex items-center flex-wrap gap-2">
                            <span class="text-xs bg-slate-200 text-slate-700 px-1.5 py-0.5 rounded">EN</span>
                            <span class="flex-1">${enDisplay}</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-1.5 self-end sm:self-center">
                        <button onclick="togglePhraseVisibility(${idx}, 'pt')" class="p-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:text-brand-600 transition" title="${isPtHidden ? 'Reveal Portuguese' : 'Hide Portuguese'}">
                            <i class="fa-solid ${isPtHidden ? 'fa-eye-slash text-brand-600' : 'fa-eye'}"></i>
                        </button>
                        <button onclick="playPronunciation('${escapeQuotes(item.pt)}', 'pt-BR')" class="p-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:text-brand-600 transition" title="Listen Portuguese">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <div class="w-px h-6 bg-slate-200 mx-1"></div>
                        <button onclick="togglePhraseVisibility(${idx}, 'en')" class="p-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:text-brand-600 transition" title="${isEnHidden ? 'Reveal English' : 'Hide English'}">
                            <i class="fa-solid ${isEnHidden ? 'fa-eye-slash text-brand-600' : 'fa-eye'}"></i>
                        </button>
                        <button onclick="playPronunciation('${escapeQuotes(item.en)}', 'en-US')" class="p-2 bg-white border border-slate-200 rounded-xl text-slate-600 hover:text-brand-600 transition" title="Listen English">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <button onclick="deleteCustomPhrase(${idx})" class="p-2 bg-rose-50 border border-rose-200 rounded-xl text-rose-600 hover:bg-rose-100 transition ml-2" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            }).join('');
        }

        function togglePhraseVisibility(index, lang) {
            if (customPhrases[index][`hide${lang.toUpperCase()}`] !== undefined) {
                customPhrases[index][`hide${lang.toUpperCase()}`] = !customPhrases[index][`hide${lang.toUpperCase()}`];
            } else {
                // Initialize based on current global state flipped
                customPhrases[index][`hide${lang.toUpperCase()}`] = !(lang === 'pt' ? hidePt : hideEn);
            }
            renderCustomPhrasesList();
        }

        function updateDashboardStats() {
            document.getElementById('statWords').innerText = customPhrases.length;
        }

        // Audio Immersion State
        let isAudioPlaying = false;
        let audioInterval = null;
        let audioProgressPercent = 0;

        function toggleAudioPlayback() {
            isAudioPlaying = !isAudioPlaying;
            const playIcon = document.getElementById('playIcon');
            const progress = document.getElementById('audioProgress');
            const btn = document.getElementById('playAudioBtn');

            if (isAudioPlaying) {
                playIcon.className = "fa-solid fa-pause";
                btn.className = "bg-amber-600 text-white w-12 h-12 rounded-full flex items-center justify-center text-lg shadow-lg hover:bg-amber-700 transition";
                
                audioInterval = setInterval(() => {
                    audioProgressPercent += 2;
                    if (audioProgressPercent > 100) {
                        audioProgressPercent = 0;
                        toggleAudioPlayback();
                        return;
                    }
                    progress.style.width = audioProgressPercent + '%';
                    const seconds = Math.floor((audioProgressPercent / 100) * 45);
                    document.getElementById('audioCurrentTime').innerText = `0:${seconds < 10 ? '0' : ''}${seconds}`;
                }, 500);
            } else {
                playIcon.className = "fa-solid fa-play";
                btn.className = "bg-brand-600 text-white w-12 h-12 rounded-full flex items-center justify-center text-lg shadow-lg hover:bg-brand-700 transition";
                clearInterval(audioInterval);
            }
        }

        function translateSentence(el, ptText, enText) {
            const box = document.getElementById('translationBox');
            box.classList.remove('hidden');
            document.getElementById('transPt').innerText = ptText;
            document.getElementById('transEn').innerText = enText;
            playPronunciation(ptText, 'pt-BR');
        }

        // AI Chat Functionality using Gemini API Endpoint
        async function sendChatMessage(e) {
            e.preventDefault();
            const inputEl = document.getElementById('chatInput');
            const query = inputEl.value.trim();
            if (!query) return;

            const chatContainer = document.getElementById('chatMessages');

            chatContainer.innerHTML += `
                <div class="flex items-start justify-end space-x-3">
                    <div class="bg-brand-600 text-white px-4 py-3 rounded-2xl rounded-tr-none max-w-md text-sm leading-relaxed shadow-sm">
                        ${escapeHtml(query)}
                    </div>
                    <div class="w-8 h-8 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold shrink-0">You</div>
                </div>
            `;
            inputEl.value = '';
            chatContainer.scrollTop = chatContainer.scrollHeight;

            const typingId = 'typing-' + Date.now();
            chatContainer.innerHTML += `
                <div id="${typingId}" class="flex items-start space-x-3">
                    <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                    <div class="bg-slate-100 text-slate-500 px-4 py-3 rounded-2xl rounded-tl-none text-sm animate-pulse">
                        Thinking...
                    </div>
                </div>
            `;
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                
                const payload = {
                    contents: [{ parts: [{ text: query }] }],
                    systemInstruction: {
                        parts: [{ text: "You are HyperLingua AI, an expert language tutor specializing in English and Portuguese. Provide helpful translations, correct grammar mistakes, and encourage bilingual conversation." }]
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                const candidate = result.candidates?.[0];
                let aiReply = "I'm having trouble connecting right now. Keep practicing your custom phrases!";

                if (candidate && candidate.content?.parts?.[0]?.text) {
                    aiReply = candidate.content.parts[0].text;
                }

                document.getElementById(typingId).remove();

                chatContainer.innerHTML += `
                    <div class="flex items-start space-x-3">
                        <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                        <div class="bg-slate-100 text-slate-800 px-4 py-3 rounded-2xl rounded-tl-none max-w-md text-sm leading-relaxed shadow-sm">
                            ${escapeHtml(aiReply)}
                        </div>
                    </div>
                `;
            } catch (err) {
                document.getElementById(typingId).remove();
                chatContainer.innerHTML += `
                    <div class="flex items-start space-x-3">
                        <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                        <div class="bg-rose-50 text-rose-700 px-4 py-3 rounded-2xl rounded-tl-none max-w-md text-sm">
                            Sorry, I encountered an error answering your request.
                        </div>
                    </div>
                `;
            }
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function clearChat() {
            document.getElementById('chatMessages').innerHTML = `
                <div class="flex items-start space-x-3">
                    <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                    <div class="bg-slate-100 text-slate-800 px-4 py-3 rounded-2xl rounded-tl-none max-w-md text-sm leading-relaxed">
                        Chat cleared. How else can I help you practice English and Portuguese today?
                    </div>
                </div>
            `;
        }

        function alertBox(msg) {
            // Non-intrusive notification badge
            const banner = document.createElement('div');
            banner.className = "fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-xl text-sm flex items-center space-x-3 animate-bounce";
            banner.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i><span>${msg}</span>`;
            document.body.appendChild(banner);
            setTimeout(() => banner.remove(), 3000);
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function escapeQuotes(text) {
            return text.replace(/'/g, "\\'").replace(/"/g, '\\"');
        }

        // Initialize on load
        window.onload = function() {
            updateDashboardStats();
            renderCustomPhrasesList();
        }
    </script>
</body>
</html>
